{
  "name": "mcp-fit",
  "version": "0.2.0",
  "description": "MCP server agent-usability scorer \u2014 scores and auto-fixes tool descriptions",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "llm",
    "tool-use",
    "linter",
    "scorecard",
    "agent-usability"
  ],
  "homepage": "https://github.com/TomCruiseTorpedo/mcp-fit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomCruiseTorpedo/mcp-fit.git"
  },
  "bugs": {
    "url": "https://github.com/TomCruiseTorpedo/mcp-fit/issues"
  },
  "author": "TomCruiseTorpedo",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "mcp-fit": "bin/mcp-fit"
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:score-sync": "bash scripts/check-sync.sh",
    "check:score-cross": "bash scripts/check-sync.sh --cross",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@anthropic-ai/sdk": "^0.102.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.17.1",
    "canonicalize": "^3.0.0",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.67"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "hono": "^4.13.7",
    "@hono/node-server": "^1.19.15",
    "fast-uri": "^3.1.8",
    "ip-address": "^10.7.1",
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8",
    "body-parser": "^2.3.0",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  }
}
